# Copy to .env and fill. Never commit real secrets.
OPENAI_API_KEY=
ADRIAN_MODEL_ID=gpt-5-mini
ADRIAN_DB_FILE=adrian.db
ADRIAN_ACTIVATION_TAG=agente-ia
ADRIAN_MAX_INSIST=2
ADRIAN_HISTORY_RUNS=8
ADRIAN_WEBHOOK_SECRET=

# CRM (GoHighLevel-style)
CRM_BASE_URL=https://services.leadconnectorhq.com
CRM_API_KEY=
CRM_LOCATION_ID=
CRM_STOCK_CUSTOM_VALUE_ID=
CRM_FAQ_CUSTOM_VALUE_ID=
CRM_ESCALATION_WORKFLOW_ID=
CRM_CALENDAR_ID=

# Opportunities / pipeline (Fase 3 / GAP-5). Commercial sync skipped unless both set.
CRM_PIPELINE_ID=
CRM_PIPELINE_STAGE_ID=

# Token cost tracking (PLACEHOLDER prices — confirm with OpenAI billing; prefer the
# `pricing` table via scripts/seed_pricing.py, these are the fallback)
OPENAI_PRICE_IN_PER_1M=0.25
OPENAI_PRICE_OUT_PER_1M=2.00
OPENAI_WHISPER_PRICE_PER_MIN=0.006
USD_BRL_RATE=5.40

# Follow-up / abandonment sweeps (minutes of inactivity)
ADRIAN_FOLLOWUP_IDLE_MIN=1440
ADRIAN_ABANDON_IDLE_MIN=4320
ADRIAN_MAX_FOLLOWUPS=1
